<!DOCTYPE html>
<html>
<head><meta charset="utf-8"></head>
<body style="font-family: Arial, sans-serif; max-width: 600px; margin: 0 auto; padding: 20px;">
  <h2 style="color: #3498db;">Payment Receipt</h2>
  <p>Thank you for your payment for auction <strong>{{auctionId}}</strong>.</p>
  {{#if amount}}<p>Amount paid: <strong>₹{{amount}}</strong></p>{{/if}}
  <p>Your item will be shipped shortly. Thank you for using BidX!</p>
  <hr style="border: none; border-top: 1px solid #eee; margin: 20px 0;">
  <p style="color: #999; font-size: 12px;">BidX Auction Platform</p>
</body>
</html>
