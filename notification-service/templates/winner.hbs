<!DOCTYPE html>
<html>
<head><meta charset="utf-8"></head>
<body style="font-family: Arial, sans-serif; max-width: 600px; margin: 0 auto; padding: 20px;">
  <h2 style="color: #27ae60;">Congratulations! You Won!</h2>
  <p>You are the winning bidder for auction <strong>{{auctionId}}</strong>.</p>
  {{#if finalPrice}}<p>Final price: <strong>₹{{finalPrice}}</strong></p>{{/if}}
  <p>Please complete your payment within the deadline to secure your item.</p>
  <hr style="border: none; border-top: 1px solid #eee; margin: 20px 0;">
  <p style="color: #999; font-size: 12px;">BidX Auction Platform</p>
</body>
</html>
