NEXT_PUBLIC_API_URL=https://api.yourdomain.com/api/v1
NEXT_PUBLIC_SOCKET_URL=https://api.yourdomain.com
NEXT_PUBLIC_API_TIMEOUT_MS=90000
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_live_replace_me

# Used by docker-compose.full.yml. Generate long, unrelated secrets.
JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
JWT_REFRESH_SECRET=replace-with-another-32-random-characters
FRONTEND_ORIGIN=http://localhost:3000
AUTH_REFRESH_COOKIE_NAME=bidx_refresh
AUTH_REFRESH_COOKIE_SECURE=false
AUTH_REFRESH_COOKIE_SAME_SITE=lax
AUTH_EXPOSE_REFRESH_TOKEN_IN_BODY=false
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=replace-with-razorpay-webhook-secret
