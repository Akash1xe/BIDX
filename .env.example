NODE_ENV=development
LOG_LEVEL=info

GATEWAY_PORT=4000

USER_SERVICE_PORT=4001

AUCTION_SERVICE_PORT=4002
MONGODB_URI_AUCTIONS=mongodb://localhost:27017/bidx_auctions

SEARCH_SERVICE_PORT=4003
ELASTICSEARCH_NODE=http://localhost:9200
AUCTIONS_INDEX=auctions
SEARCH_INDEXER_GROUP_ID=bidx-search-indexer

BIDDING_SERVICE_PORT=4004
MONGODB_URI_BIDS=mongodb://localhost:27017/bidx_bids
BID_LOCK_TTL_MS=5000
BID_LOCK_RETRIES=8
BID_LOCK_RETRY_DELAY_MS=120
BID_OCC_MAX_RETRIES=3
IDEMPOTENCY_TTL_SECONDS=600

PAYMENT_SERVICE_PORT=4005
MONGODB_URI_PAYMENTS=mongodb://localhost:27017/bidx_payments
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=bidx-dev-webhook-secret
PAYMENT_WINNERS_GROUP_ID=bidx-payment-winners
PAYMENT_ORDER_TTL_HOURS=48

PAYMENT_DEADLINE_MS=172800000
SAGA_SCAN_INTERVAL_MS=5000
SAGA_GROUP_ID=bidx-saga-orchestrator

NOTIFICATION_SERVICE_PORT=4006
MONGODB_URI_NOTIFICATIONS=mongodb://localhost:27017/bidx_notifications
NOTIFICATION_GROUP_ID=bidx-notification-emails
EMAIL_MODE=dev
SENDGRID_API_KEY=
EMAIL_FROM=noreply@bidx.dev
EMAIL_FROM_NAME=BidX

ADMIN_SERVICE_PORT=4007
MONGODB_URI_ADMIN=mongodb://localhost:27017/bidx_admin

MONGODB_URI_USERS=mongodb://localhost:27017/bidx_users

REDIS_URL=redis://localhost:6379

JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

GOOGLE_CLIENT_ID=

OTP_LENGTH=6
OTP_TTL_SECONDS=300
OTP_THROTTLE_SECONDS=60
OTP_MAX_ATTEMPTS=5
OTP_VERIFICATION_TTL_SECONDS=600

RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_API_MAX=100
RATE_LIMIT_AUTH_MAX=10

CACHE_USER_TTL_SECONDS=60

KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=bidx-user-service

CORS_ORIGINS=*
GATEWAY_RATE_LIMIT_WINDOW_MS=60000
GATEWAY_RATE_LIMIT_MAX=300
UPSTREAM_TIMEOUT_MS=8000
CIRCUIT_FAILURE_THRESHOLD=3
CIRCUIT_OPEN_MS=10000
CIRCUIT_HALF_OPEN_PROBES=1

USER_SERVICE_URL=http://localhost:4001
AUCTION_SERVICE_URL=http://localhost:4002
SEARCH_SERVICE_URL=http://localhost:4003
BIDDING_SERVICE_URL=http://localhost:4004
PAYMENT_SERVICE_URL=http://localhost:4005
NOTIFICATION_SERVICE_URL=http://localhost:4006
ADMIN_SERVICE_URL=http://localhost:4007
